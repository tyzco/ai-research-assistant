# ============================================================
# PaperLink 环境配置
# 复制: cp .env.example .env 并填入你的密钥
# ============================================================

# ---------- DeepSeek API (必填) ----------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ---------- 本地嵌入模型 (默认 bge-small-zh 512d) ----------
# 升级: BAAI/bge-m3 维度 1024 (需 pip install FlagEmbedding + python reindex_all.py)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh
LOCAL_EMBEDDING_DIM=512

# ---------- 重排模型 ----------
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_STAGE1_MODEL=all-MiniLM-L6-v2

# ---------- JWT 认证 (生产必须改) ----------
JWT_SECRET_KEY=change-me-to-a-random-string

# ---------- CORS (部署到服务器时改为实际域名) ----------
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# ---------- 可选 API Key ----------
# Semantic Scholar: https://api.semanticscholar.org/ (免费注册)
# SEMANTIC_SCHOLAR_API_KEY=
# Google Scholar via Apify
# APIFY_API_KEY=

# ---------- 调整参数 ----------
MAX_SEARCH_RESULTS=50
CHUNK_SIZE=4096
RETRIEVAL_TOP_K=5
LOG_LEVEL=INFO

# ---------- 可调参数 (全部可选, 默认值见 config.py) ----------
# LLM 生成
# LLM_GEN_TEMPERATURE=0.3
# LLM_GEN_MAX_TOKENS=2048
# LLM_GEN_TIMEOUT=30
# 检索超时 (秒, 按源)
# SEARCH_TIMEOUT_ARXIV=10
# SEARCH_TIMEOUT_S2=5
# SEARCH_TIMEOUT_CNKI=2
# Agent
# AGENT_MAX_STEPS=10
# AGENT_MAX_TOKENS=4096
# AGENT_TEMPERATURE=0.3
# 记忆
# MEMORY_MAX_RECENT=5
# MEMORY_HISTORY_TURNS=8
# 资源限制
# MAX_UPLOAD_BYTES=52428800
# DOWNLOAD_CONCURRENCY=3
# 安全
# TOOL_SECURITY_BLOCK_NON_WHITELIST=false   # true=严格模式(非白名单域名直接阻止)
# HOOK_SENSITIVE_WORDS=rm -rf /,DROP TABLE  # 逗号分隔, 空=不拦截
# RAG 重排触发
# RERANK_INTENT_THRESHOLD=0.6
# RERANK_QUALITY_TRIGGER=0.45
# 意图语义层 (三层漏斗中间层)
# INTENT_SEMANTIC_ENABLED=true
# INTENT_SEMANTIC_MARGIN=0.06
# INTENT_SEMANTIC_FLOOR=0.60
# Agent 上下文窗口 (默认 1M, 用满模型真实窗口, 论文高精度场景防幻觉)
# AGENT_CONTEXT_MAX_TOKENS=1000000
# AGENT_CONTEXT_RESERVE_TOKENS=8192
# Agent 反思重试闭环 (直答后自批判, 不足则带批判重试一轮; false=关闭省一次LLM调用)
# AGENT_REFLEXION_ENABLED=true
# 按量付费配额 (免费额度体验 → 用量追踪 → 超额充值)
# QUOTA_ENABLED=true
# QUOTA_FREE_TOKENS=100000
